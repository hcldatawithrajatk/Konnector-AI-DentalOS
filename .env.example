# ==============================================================================
# KONNECTOR AI DENTALOS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables
# in your cloud hosting provider (Vercel, GCP Cloud Run, AWS ECS).

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://care.konnectordental.app
NEXT_PUBLIC_APP_NAME="Konnector AI DentalOS"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD PLATFORM & GEMINI 2.5 AI
# ------------------------------------------------------------------------------
# Google Cloud Project ID hosting Vertex AI and Cloud Storage
GCP_PROJECT_ID=konnector-dentalos-prod
GCP_REGION=us-central1

# Gemini 2.5 Pro & Flash API Keys (from Google AI Studio or GCP Vertex AI)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Vertex AI Vector Search Index Details (for clinical RAG Knowledge Base)
VERTEX_VECTOR_INDEX_ID=vtx-dental-index-01
VERTEX_VECTOR_ENDPOINT_ID=vtx-endpoint-dental-01
GCS_KNOWLEDGE_BUCKET_NAME=konnector-dentalos-knowledge-docs

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API (BUSINESS MESSAGING)
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers (Business Manager -> WhatsApp App)
WHATSAPP_CLOUD_API_ACCESS_TOKEN=EAAGYourWhatsAppPermanentSystemUserToken
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_ACCOUNT_ID=7762514930218
WHATSAPP_WEBHOOK_VERIFY_TOKEN=konnector_secret_verify_token_dentalos_2025

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION & FIRESTORE REALTIME
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=konnector-dentalos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=konnector-dentalos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=konnector-dentalos.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=982301928301
NEXT_PUBLIC_FIREBASE_APP_ID=1:982301928301:web:a1b2c3d4e5f6g7h8

# Firebase Admin SDK Service Account (Base64 encoded or JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ------------------------------------------------------------------------------
# 5. POSTGRESQL DATABASE & REDIS CACHE
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://dental_admin:YourSecurePassword@localhost:5432/dentalos_db?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 6. INDIA PAYMENTS (RAZORPAY & UPI)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard (API Keys & Webhooks)
RAZORPAY_KEY_ID=rzp_live_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 7. UNITED STATES PAYMENTS (STRIPE)
# ------------------------------------------------------------------------------
# Obtain from Stripe Dashboard (Developers -> API Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YourStripePublishableKey
STRIPE_SECRET_KEY=sk_live_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecret

# ------------------------------------------------------------------------------
# 8. CALENDAR INTEGRATIONS (GOOGLE & MICROSOFT OUTLOOK)
# ------------------------------------------------------------------------------
# Google Calendar API (Google Cloud Console OAuth 2.0 Client)
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-yourGoogleClientSecret
GOOGLE_CALENDAR_REDIRECT_URI=https://care.konnectordental.app/api/auth/callback/google-calendar

# Microsoft Outlook Calendar API (Azure Portal App Registration)
AZURE_MICROSOFT_CLIENT_ID=your-azure-app-client-id
AZURE_MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
AZURE_MICROSOFT_REDIRECT_URI=https://care.konnectordental.app/api/auth/callback/microsoft-calendar

# ------------------------------------------------------------------------------
# 9. HEALTHCARE COMPLIANCE ENFORCEMENT
# ------------------------------------------------------------------------------
HIPAA_AUDIT_LOGGING_ENABLED=true
DPDPA_INDIA_CONSENT_REQUIRED=true
ENCRYPTION_KEY_AES256=2b7e151628aed2a6abf7158809cf4f3c2b7e151628aed2a6abf7158809cf4f3c
